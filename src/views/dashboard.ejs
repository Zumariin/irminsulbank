<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Irminsul Bank</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        html {
            scroll-behavior: smooth;
        }
        body {
            font-family: Georgia, 'Times New Roman', Times, serif;
            line-height: 1.6;
            background: url('https://wallpapers.com/images/hd/genshin-impact-beautiful-scenery-2lx7afb1zivx6o1d.jpg') no-repeat center center fixed;
            background-size: cover;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        header {
            background-color: #31a5e9;
            color: #ffffff;
            padding: 1rem;
            width: 100%;
        }

        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 24px;
            font-weight: bold;
        }

        nav ul {
            display: flex;
            list-style-type: none;
        }

        nav ul li {
            margin-left: 1rem;
        }

        nav ul li a {
            color: #ffffff;
            text-decoration: none;
            transition: color 0.3s ease;
        }

        nav ul li a:hover {
            color: #000000;
        }

        .sidebar {
            width: 200px;
            background-color: #e0f2ff;
            padding: 20px;
            box-shadow: 2px 0 5px rgba(0, 0, 0, 0.1);
            height: calc(100vh - 3rem); /* Full height minus the header */
        }

        .sidebar ul {
            list-style-type: none;
            padding: 0;
        }

        .sidebar ul li {
            margin-bottom: 20px;
        }

        .sidebar ul li a {
            color: #007acc;
            text-decoration: none;
            font-weight: bold;
            display: block;
            padding: 10px;
            border-radius: 4px;
            transition: background-color 0.3s ease;
        }

        .sidebar ul li a:hover {
            background-color: #cce6ff;
        }

        .container-content {
            flex: 1;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
        }

        .welcome-text {
            color: #000000;
            font-size: 1.5em;
            text-align: center;
            margin-top: 10px;
            margin-bottom: 20px;
            text-shadow: 1px 1px 2px #ffffff;
        }
        .container-logo {
            display: flex;
            flex-direction: row;
            }

            .image-logo {
            width: 50px;
            height: 50px;
            margin-right: 12px;
            }

    </style>
</head>
<body>

    <header>
        <nav style="display: flex; justify-content: space-between; flex-direction: row; width: 100%;">
            <div style="display: flex; flex-direction: row; align-items: center;" class="container-logo">
                <img class="image-logo" src="https://ik.imagekit.io/ypj908auu/img/irminsul%20bank%20logo.png" alt="">
                <div class="logo">Irminsul Bank</div>
            </div>            <ul>
                <li><a href="/">Logout</a></li>
            </ul>
        </nav>
    </header>

    <div style="display: flex;">
        <div class="sidebar">
            <ul>
                <li><a href="/dashboard">Dashboard</a></li>
                <li><a href="/dashboard/character-main">Character</a></li>
                <li><a href="/dashboard/character-sup">Charasup</a></li>
                <li><a href="/dashboard/artefak">Artefak</a></li>
                <li><a href="/dashboard/batu-ascend">Batu Ascend</a></li>
            </ul>
        </div>
        
        <div class="container-content">
            <div class="header">
                <h1>Manage Irminsul Bank</h1>
                <div class="welcome-text">
                    Selamat Datang<br>
                    Dashboard Admin Irminsul Bank
                </div>
            </div>
        </div>
    
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', async function() {
            const token = localStorage.getItem('token');
    
            if (!token) {
                window.location.href = '/';
                return;
            }
    
            try {
                const response = await fetch('<%= apiBaseUrl %>/api/v1/auth/whoami', {
                    method: 'GET',
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });
    
                const result = await response.json();

                console.log(result)

                console.log(result.data)
    
                if (!result.message) {
                    window.location.href = '/'; 
                }
            } catch (error) {
                console.error('Error:', error);
                window.location.href = '/'; 
            }
        });
    </script>
    
</body>
</html>
