<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Irminsul Bank</title>
    <style>
                * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        html {
            scroll-behavior: smooth;
        }
        body {
            font-family: Georgia, 'Times New Roman', Times, serif;
            line-height: 1.6;
            background: url('https://wallpapers.com/images/hd/genshin-impact-beautiful-scenery-2lx7afb1zivx6o1d.jpg') no-repeat center center fixed;
            background-size: cover;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        header {
            background-color: #31a5e9;
            color: #ffffff;
            padding: 1rem;
            width: 100%;
            position: fixed;
            height: max-content;
        }

        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 24px;
            font-weight: bold;
        }

        nav ul {
            display: flex;
            list-style-type: none;
        }

        nav ul li {
            margin-left: 1rem;
        }

        nav ul li a {
            color: #ffffff;
            text-decoration: none;
            transition: color 0.3s ease;
        }

        nav ul li a:hover {
            color: #000000;
        }

        .sidebar {
            width: 200px;
            background-color: #e0f2ff;
            padding: 20px;
            box-shadow: 2px 0 5px rgba(0, 0, 0, 0.1);
            height: calc(100vh - 3rem);
            position: fixed;
            margin-top: 70px;
        }

        .sidebar ul {
            list-style-type: none;
            padding: 0;
        }

        .sidebar ul li {
            margin-bottom: 20px;
        }

        .sidebar ul li a {
            color: #007acc;
            text-decoration: none;
            font-weight: bold;
            display: block;
            padding: 10px;
            border-radius: 4px;
            transition: background-color 0.3s ease;
        }

        .sidebar ul li a:hover {
            background-color: #cce6ff;
        }

        .container-content {
            margin-left: 220px;
            margin-top: 90px;
            flex: 1;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
        }

        .welcome-text {
            color: #000000;
            font-size: 1.5em;
            text-align: center;
            margin-top: 10px;
            margin-bottom: 20px;
            text-shadow: 1px 1px 2px #ffffff;
        }

        .character-list-table {
            width: 80%;
            margin: 20px auto;
            border-collapse: collapse;
            background-color: #f9f9f9;
        }
        
        .character-list-table th, .character-list-table td {
            padding: 12px;
            text-align: center;
            border-bottom: 1px solid #ddd;
        }
        
        .character-list-table th {
            background-color: #007acc;
            color: white;
        }

        .character-list-table td img {
            width: 50px;
            height: auto;
        }

        .add-button {
            margin: 20px;
            margin-right: 0;
            padding: 10px 20px;
            background-color: #007acc;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            transition: background-color 0.3s ease;
            width: 90px;
        }

        .add-button:hover {
            background-color: #005fa3;
        }

        .remove-button {
            margin: 20px;
            margin-right: 0;
            padding: 10px 20px;
            background-color: #df2323;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            transition: background-color 0.3s ease;
            width: 90px;
        }

        .remove-button:hover {
            background-color: #ac1f1f;
        }

        .edit-button {
            margin: 20px;
            margin-right: 0;
            padding: 10px 20px;
            background-color: #11ac3f;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            transition: background-color 0.3s ease;
            width: 90px;
        }

        .edit-button:hover {
            background-color: #147030;
        }
    </style>
</head>
<body>

    <header>
        <nav>
            <div class="logo">Irminsul Bank Admin</div>
            <ul>
                <li><a href="/">Logout</a></li>
            </ul>
        </nav>
    </header>

    <div style="display: flex;">
        <div class="sidebar">
            <ul>
                <li><a href="/dashboard">Dashboard</a></li>
                <li><a href="/dashboard/character-main">Character</a></li>
                <li><a href="/dashboard/character-sup">Charasup</a></li>
                <li><a href="/dashboard/artefak">Artefak</a></li>
                <li><a href="/dashboard/batu-ascend">Batu Ascend</a></li>
            </ul>
        </div>
        
        <div class="container-content">
            <div style="display: flex; justify-content: space-between; align-items: center; width: 80%;">
                <h1>Data Character Support</h1>
            </div>
            <table class="character-list-table">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Foto Charasup</th>
                        <th>Nama Charasup</th>
                    </tr>
                </thead>
                <tbody>
                    <% characterSupport.forEach((character, index) => { %>
                    <tr>
                        <td><%= index + 1 %></td>
                        <td><img src="<%= character.Foto_charasup %>" alt="Foto Charasup" width="50"></td>
                        <td><%= character.Nama_charasup %></td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <script>
        // Your existing scripts here
    </script>
    
</body>
</html>
