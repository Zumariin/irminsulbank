<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Irminsul Bank</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        html {
            scroll-behavior: smooth;
        }
        body {
            font-family: Georgia, 'Times New Roman', Times, serif;
            line-height: 1.6;
            background: url('https://wallpapers.com/images/hd/genshin-impact-beautiful-scenery-2lx7afb1zivx6o1d.jpg') no-repeat center center fixed;
            background-size: cover;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        header {
            background-color: #31a5e9;
            color: #ffffff;
            padding: 1rem;
            width: 100%;
            position: fixed;
            height: max-content;
        }

        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 24px;
            font-weight: bold;
        }

        nav ul {
            display: flex;
            list-style-type: none;
        }

        nav ul li {
            margin-left: 1rem;
        }

        nav ul li a {
            color: #ffffff;
            text-decoration: none;
            transition: color 0.3s ease;
        }

        nav ul li a:hover {
            color: #000000;
        }

        .sidebar {
            width: 200px;
            background-color: #e0f2ff;
            padding: 20px;
            box-shadow: 2px 0 5px rgba(0, 0, 0, 0.1);
            height: calc(100vh - 3rem);
            position: fixed;
            margin-top: 70px;
        }

        .sidebar ul {
            list-style-type: none;
            padding: 0;
        }

        .sidebar ul li {
            margin-bottom: 20px;
        }

        .sidebar ul li a {
            color: #007acc;
            text-decoration: none;
            font-weight: bold;
            display: block;
            padding: 10px;
            border-radius: 4px;
            transition: background-color 0.3s ease;
        }

        .sidebar ul li a:hover {
            background-color: #cce6ff;
        }

        .container-content {
            margin-left: 220px;
            margin-top: 90px;
            flex: 1;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
        }

        .welcome-text {
            color: #000000;
            font-size: 1.5em;
            text-align: center;
            margin-top: 10px;
            margin-bottom: 20px;
            text-shadow: 1px 1px 2px #ffffff;
        }

        .character-list-table {
            width: 80%;
            margin: 20px auto;
            border-collapse: collapse;
            background-color: #f9f9f9;
        }
        
        .character-list-table th, .character-list-table td {
            padding: 12px;
            text-align: center;
            border-bottom: 1px solid #ddd;
        }
        
        .character-list-table th {
            background-color: #007acc;
            color: white;
        }

        .character-list-table td img {
            width: 50px;
            height: auto;
        }

        .add-button {
            margin: 20px;
            margin-right: 0;
            padding: 10px 20px;
            background-color: #007acc;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            transition: background-color 0.3s ease;
            width: 90px;
        }

        .add-button:hover {
            background-color: #005fa3;
        }

        .remove-button {
            margin: 20px;
            margin-right: 0;
            padding: 10px 20px;
            background-color: #df2323;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            transition: background-color 0.3s ease;
            width: 90px;
        }

        .remove-button:hover {
            background-color: #ac1f1f;
        }

        .edit-button {
            margin: 20px;
            margin-right: 0;
            padding: 10px 20px;
            background-color: #11ac3f;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            transition: background-color 0.3s ease;
            width: 90px;
        }

        .edit-button:hover {
            background-color: #147030;
        }

        .container-logo {
            display: flex;
            flex-direction: row;
            }

            .image-logo {
            width: 50px;
            height: 50px;
            margin-right: 12px;
            }
    </style>
</head>
<body>

    <header>
        <nav style="display: flex; justify-content: space-between; flex-direction: row; width: 100%;">
            <div style="display: flex; flex-direction: row; align-items: center;" class="container-logo">
                <img class="image-logo" src="https://ik.imagekit.io/ypj908auu/img/irminsul%20bank%20logo.png" alt="">
                <div class="logo">Irminsul Bank</div>
            </div>            <ul>
                <li><a href="/">Logout</a></li>
            </ul>
        </nav>
    </header>

    <div style="display: flex;">
        <div class="sidebar">
            <ul>
                <li><a href="/dashboard">Dashboard</a></li>
                <li><a href="/dashboard/character-main">Character</a></li>
                <li><a href="/dashboard/character-sup">Charasup</a></li>
                <li><a href="/dashboard/artefak">Artefak</a></li>
                <li><a href="/dashboard/batu-ascend">Batu Ascend</a></li>
            </ul>
        </div>
        
        <div class="container-content">
            <div style="display: flex; justify-content: space-between; align-items: center; width: 80%;">
                <h1>Data Character List</h1>
                <a href="/dashboard/admin/tambah-character"><button class="add-button">Tambah</button></a>
            </div>
            <table class="character-list-table">
                <thead>
                    <tr>
                        <th>No</th>
                        <th>Gambar</th>
                        <th>Nama</th>
                        <th>Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    <% data.forEach((character, index) => { %>
                    <tr>
                        <td><%= index + 1 %></td>
                        <td><img src="<%= character.link_avatar %>" alt="Gambar Character" width="50"></td>
                        <td><%= character.Nama_chara %></td>
                        <td>
                            <a href="/dashboard/admin/update-character/<%= character.id %>"><button class="edit-button">Edit</button></a>
                            <button class="remove-button" data-id="<%= character.id %>">Delete</button>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', async function() {
            const token = localStorage.getItem('token');

            if (!token) {
                window.location.href = '/';
                return;
            }

            try {
                const response = await fetch('<%= apiBaseUrl %>/api/v1/auth/whoami', {
                    method: 'GET',
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });

                const result = await response.json();

                if (!result.message) {
                    window.location.href = '/'; 
                }
            } catch (error) {
                console.error('Error:', error);
                window.location.href = '/'; 
            }
        });

        document.addEventListener('click', async function(event) {
            if (event.target.classList.contains('remove-button')) {
                const id = event.target.getAttribute('data-id');

                if (confirm('Are you sure you want to delete this character?')) {
                    try {
                        const response = await fetch(`<%= apiBaseUrl %>/api/v1/delete/character/${id}`, {
                            method: 'DELETE',
                            headers: {
                                'Authorization': `Bearer ${localStorage.getItem('token')}`
                            }
                        });

                        const result = await response.json();

                        if (result.status) {
                            alert(result.message);
                            // Reload the page or remove the row from the table
                            window.location.reload();
                        } else {
                            alert(result.message);
                        }
                    } catch (error) {
                        console.error('Error:', error);
                        alert('Terjadi kesalahan, coba lagi nanti.');
                    }
                }
            }
        });
    </script>
    
</body>
</html>