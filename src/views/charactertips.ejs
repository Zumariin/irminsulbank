<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Character List - Irminsul Bank</title>
    <link rel="stylesheet" href="/css/charactertips.css">
    <style>
        a {
            text-decoration: none;
        }

        .container-logo {
            display: flex;
            flex-direction: row;
            }

            .image-logo {
            width: 50px;
            height: 50px;
            margin-right: 12px;
            }
    </style>
</head>
<body>
    <!-- Header -->
    <header>
        <nav style="display: flex; justify-content: space-between; flex-direction: row; width: 100%;">
            <div style="display: flex; flex-direction: row; align-items: center;" class="container-logo">
                <img class="image-logo" src="https://ik.imagekit.io/ypj908auu/img/irminsul%20bank%20logo.png" alt="">
                <div class="logo">Irminsul Bank</div>
            </div>            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/about">About Us</a></li>
            </ul>
        </nav>
    </header>

    <main>
        <h1>Character Build & Tips</h1>
        
        <div class="character-grid">
            <!-- Dynamically generated character items -->
            <% karakter.forEach(chara => { %>
                <div class="character-item" onclick="toggleDetails('<%= chara.Nama_chara %>')">
                    <img src="<%= chara.link_avatar %>" alt="<%= chara.Nama_chara %>">
                    <a href="/character-details/name/<%= chara.Nama_chara %>">
                        <h3><%= chara.Nama_chara %></h3>
                    </a>
                </div>
            <% }); %>
        </div>
        
    </main>

    <footer>
        <p>&copy; 2024 Irminsul Bank. All rights reserved.</p>
        <a href="#" id="scrollToTop" class="top">&#8593;</a>
    </footer>
    
    <script src="/Javascript file/scrollbutton.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var scrollToTopBtn = document.getElementById("scrollToTop");

            // Show button when user scrolls down 20px from the top of the document
            window.onscroll = function() {
                if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
                    scrollToTopBtn.style.display = "block";
                } else {
                    scrollToTopBtn.style.display = "none";
                }
            };

            // Scroll to top when button is clicked
            scrollToTopBtn.addEventListener("click", function(e) {
                e.preventDefault();
                document.body.scrollTop = 0; // For Safari
                document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
                scrollToTopBtn.classList.add('top-scroll');
                setTimeout(function() {
                    scrollToTopBtn.classList.remove('top-scroll');
                }, 1000);
            });
        });

        function toggleDetails(character) {
            var details = document.getElementById(character + '-details');
            if (details.style.display === 'none') {
                details.style.display = 'block';
            } else {
                details.style.display = 'none';
            }
        }
    </script>
</body>
</html>
